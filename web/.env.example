# Copying this file verbatim will not start the application; replace placeholders locally.
# PGlite integration tests do not read DATABASE_URL.
DATABASE_URL=<local-loopback-postgresql-url>
BETTER_AUTH_URL=<local-origin-such-as-http://localhost:3000>
BETTER_AUTH_SECRET=<generate-a-unique-random-secret-of-at-least-32-characters>
MOONLIGHT_PUBLIC_ORIGIN=<same-origin-as-BETTER_AUTH_URL>
# Set only behind an ingress that overwrites and protects this header.
MOONLIGHT_TRUSTED_CLIENT_IP_HEADER=<x-real-ip-or-cf-connecting-ip>
